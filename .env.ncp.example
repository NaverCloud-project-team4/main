ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://app_user:URL_ENCODED_PASSWORD@PRIVATE_DB_HOST:3306/kkawooroong?charset=utf8mb4
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_API_URL=https://api.YOUR_DOMAIN
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://kr.object.ncloudstorage.com
S3_REGION=kr-standard
S3_BUCKET=YOUR_PRIVATE_REPORT_BUCKET
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY
VERIFICATION_MODE=clova
CLOVA_API_KEY=YOUR_CLOVA_API_KEY
CLOVA_MODEL=HCX-005
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REPORT_COOLDOWN_SECONDS=30
