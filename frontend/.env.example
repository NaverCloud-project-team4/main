VITE_API_BASE_URL=http://127.0.0.1:8000

# NCP Maps > Application > Client ID (public browser key; never put Client Secret here)
VITE_NAVER_MAP_CLIENT_ID=

# Published Style Editor style (ordinary shop POIs hidden); shared by both maps.
# Release reference: 20261023163956. SDK uses the ID without a version parameter.
VITE_NAVER_MAP_STYLE_ID=2ca6dae8-1af8-4390-b762-6f2736423d59

# Map look: classic (default, current map) | watercolor (illustrated map). Keep classic as the demo fallback.
VITE_MAP_THEME=classic
# Optional Style Editor style for the watercolor theme (tiles show through at zoom 15+).
VITE_NAVER_MAP_STYLE_ID_WATERCOLOR=
# Zone refresh interval in ms (lower it, e.g. 15000, for live demos).
VITE_ZONE_POLL_MS=60000
